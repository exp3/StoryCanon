# Example of the runtime .env that scripts/deploy-hybrid.ps1 generates ON the
# instance from AWS Secrets Manager. You do NOT create this file by hand for a
# deploy; it documents which keys the web container and docker compose consume.
#
# Non-secret values are injected by the deploy script from CDK stack outputs.
# Secret values (marked below) are read on the instance from the
# `storycanon-<stage>/<NAME>` secrets, so they never pass through the SSM payload.

# --- interpolated by docker compose (compose file) ---
IMAGE_URI=<account>.dkr.ecr.ap-northeast-1.amazonaws.com/storycanon-dev-web:latest
CLOUDFLARE_TUNNEL_TOKEN=<secret: storycanon-dev/CLOUDFLARE_TUNNEL_TOKEN>

# --- non-secret app config ---
NODE_ENV=production
APP_ENV=storycanon-dev
PAYMENT_MODE=mock
DATABASE_HOST=<rds-endpoint>
DATABASE_PORT=5432
EXPORT_BUCKET_NAME=storycanon-dev-exports-<account>
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# --- secrets (read on instance from Secrets Manager) ---
DATABASE_URL=<secret: storycanon-dev/DATABASE_URL>
NEXTAUTH_URL=<secret: storycanon-dev/NEXTAUTH_URL>
NEXTAUTH_SECRET=<secret: storycanon-dev/NEXTAUTH_SECRET>
GOOGLE_CLIENT_ID=<secret: storycanon-dev/GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<secret: storycanon-dev/GOOGLE_CLIENT_SECRET>
STRIPE_SECRET_KEY=<secret: storycanon-dev/STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<secret: storycanon-dev/STRIPE_WEBHOOK_SECRET>
APP_API_TOKEN_PEPPER=<secret: storycanon-dev/APP_API_TOKEN_PEPPER>
