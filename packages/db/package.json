{
  "name": "@storycanon/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/node/client.d.ts",
  "main": "./dist/node/client.js",
  "exports": {
    ".": {
      "types": "./dist/node/client.d.ts",
      "workerd": "./dist/workers/client.js",
      "default": "./dist/node/client.js"
    }
