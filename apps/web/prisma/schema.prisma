generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum Visibility {
  PRIVATE
}

enum CreatedBy {
  USER
  CHATGPT
}

enum Importance {
  LOW
  MEDIUM
  HIGH
}

enum CharacterNoteCategory {
  INNER
  RELATIONSHIP
  BACKGROUND
  SPEECH
  PLOT
  OTHER
}

enum WorldNoteCategory {
  PLACE
  ORGANIZATION
  TECHNOLOGY
  HISTORY
  CULTURE
  ITEM
  RULE
  OTHER
}

enum PlotThreadStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  DROPPED
}

enum MysteryScope {
  CENTRAL
  ARC
  EPISODE
  SCENE
}

enum ForeshadowingStatus {
  UNPLANTED
  PLANTED
  IN_PROGRESS
  RESOLVED
  DROPPED
}

enum RevisionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RevisionStatus {
  OPEN
  IN_PROGRESS
  DONE
  ON_HOLD
  DROPPED
}

enum RevisionSource {
  USER
  CHATGPT
}

model User {
  id                    String            @id @default(cuid())
  name                  String?
  email                 String?           @unique
  emailVerified         DateTime?
  image                 String?
  locale                String            @default("en")
  onboardingCompletedAt DateTime?
  accounts              Account[]
  sessions              Session[]
  subscriptions         Subscription[]
  apiTokens             ApiToken[]
  projects              Project[]
  auditLogs             AuditLog[]
  mutationLogs          MutationLog[]
  readingProgress       ReadingProgress[]
  oauthGrants           OAuthGrant[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String
  tokenPrefix String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenPrefix])
}

/// An MCP client registered through RFC 7591 dynamic client registration.
/// Public clients only — no secret is issued, so PKCE is what proves the
/// token request came from the same client that started the flow.
model OAuthClient {
  id           String       @id @default(cuid())
  clientId     String       @unique
  clientName   String?
  redirectUris String[]
  grantTypes   String[]
  scope        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  grants       OAuthGrant[]

  @@index([createdAt])
}

/// One user's standing consent for one client. Everything issued to that pair
/// hangs off this row, so revoking a connection is a single delete.
model OAuthGrant {
  id        String                   @id @default(cuid())
  clientId  String
  userId    String
  scope     String
  resource  String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  client    OAuthClient              @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codes     OAuthAuthorizationCode[]
  tokens    OAuthToken[]

  @@unique([clientId, userId])
  @@index([userId])
}

/// A single-use authorization code. Short-lived and stored hashed, so a leaked
/// database row cannot be replayed against the token endpoint.
model OAuthAuthorizationCode {
  id            String     @id @default(cuid())
  codeHash      String     @unique
  grantId       String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String?
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime   @default(now())
  grant         OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum OAuthTokenKind {
  ACCESS
  REFRESH
}

/// Access and refresh tokens. Opaque and hashed rather than JWTs: the database
/// is already on the request path, and revocation has to take effect at once.
model OAuthToken {
  id           String         @id @default(cuid())
  grantId      String
  kind         OAuthTokenKind
  tokenPrefix  String
  tokenHash    String         @unique
  scope        String
  resource     String?
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set on a refresh token when rotation replaces it, so replaying the old
  /// one is detectable.
  replacedById String?
  lastUsedAt   DateTime?
  createdAt    DateTime       @default(now())
  grant        OAuthGrant     @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([tokenPrefix, kind])
  @@index([grantId])
}

model Project {
  id                  String               @id @default(cuid())
  userId              String
  title               String
  genre               String?
  premise             String?
  tone                String?
  targetAudience      String?
  writingStyle        String?
  forbiddenElements   String?
  userPreferences     String?
  visibility          Visibility           @default(PRIVATE)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters            Chapter[]
  scenes              Scene[]
  characters          Character[]
  characterNotes      CharacterNote[]
  worldNotes          WorldNote[]
  plotThreads         PlotThread[]
  foreshadowings      Foreshadowing[]
  mysteries           Mystery[]
  revisionTodos       RevisionTodo[]
  storyStateSnapshots StoryStateSnapshot[]
  exportJobs          ExportJob[]
  mutationLogs        MutationLog[]
  readingProgress     ReadingProgress[]
  timelineEvents      TimelineEvent[]
  timelineTags        TimelineTag[]

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
}

model Chapter {
  id        String    @id @default(cuid())
  projectId String
  title     String
  order     Int
  summary   String?
  purpose   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    Scene[]

  @@unique([projectId, order])
  @@index([projectId, deletedAt])
}

model Scene {
  id               String    @id @default(cuid())
  projectId        String
  chapterId        String?
  title            String
  order            Int
  body             String
  summary          String?
  occurredEvents   String?
  generationPrompt String?
  createdBy        CreatedBy @default(USER)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter          Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([projectId, order])
  @@index([projectId, deletedAt])
}

model Character {
  id             String          @id @default(cuid())
  projectId      String
  name           String
  role           String?
  age            String?
  personality    String?
  speechStyle    String?
  appearance     String?
  background     String?
  goal           String?
  secret         String?
  currentState   String?
  firstSceneId   String?
  lastSceneId    String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes          CharacterNote[]
  timelineEvents TimelineEvent[] @relation("TimelineEventCharacters")

  @@unique([projectId, name])
  @@index([projectId, deletedAt])
}

model CharacterNote {
  id             String                 @id @default(cuid())
  projectId      String
  characterId    String
  title          String?
  body           String
  category       CharacterNoteCategory?
  importance     Importance             @default(MEDIUM)
  relatedSceneId String?
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character      Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
  @@index([characterId, deletedAt])
}

model WorldNote {
  id             String            @id @default(cuid())
  projectId      String
  title          String
  body           String
  category       WorldNoteCategory @default(OTHER)
  importance     Importance        @default(MEDIUM)
  relatedSceneId String?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
}

model PlotThread {
  id                  String           @id @default(cuid())
  projectId           String
  title               String
  description         String?
  status              PlotThreadStatus @default(NOT_STARTED)
  startSceneId        String?
  currentState        String?
  resolutionCondition String?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
}

model Foreshadowing {
  id                String              @id @default(cuid())
  projectId         String
  title             String
  description       String
  plantedSceneId    String?
  plannedResolution String?
  resolvedSceneId   String?
  status            ForeshadowingStatus @default(UNPLANTED)
  importance        Importance          @default(MEDIUM)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
}

model Mystery {
  id          String       @id @default(cuid())
  projectId   String
  scope       MysteryScope @default(CENTRAL)
  question    String
  truth       String?
  knownBy     String?
  clues       String?
  revealPoint String?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
}

model RevisionTodo {
  id         String           @id @default(cuid())
  projectId  String
  chapterId  String?
  sceneId    String?
  title      String
  problem    String
  suggestion String?
  priority   RevisionPriority @default(MEDIUM)
  status     RevisionStatus   @default(OPEN)
  source     RevisionSource   @default(USER)
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
}

model StoryStateSnapshot {
  id                       String    @id @default(cuid())
  projectId                String
  summary                  String
  recentEvents             String?
  characterStates          String?
  unresolvedProblems       String?
  unresolvedForeshadowings String?
  activePlotThreads        String?
  nextOptions              String?
  avoidElements            String?
  writingRules             String?
  userPreferences          String?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, deletedAt])
}

model TimelineEvent {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  description String?
  // In-story date, kept as free text: fiction rarely maps onto a real calendar
  // ("Imperial year 302, spring"). `order` is what the timeline sorts by.
  occurredAt  String?
  order       Int
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characters  Character[]   @relation("TimelineEventCharacters")
  tags        TimelineTag[] @relation("TimelineEventTags")

  @@index([projectId, order])
  @@index([projectId, deletedAt])
}

model TimelineTag {
  id        String          @id @default(cuid())
  projectId String
  name      String
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events    TimelineEvent[] @relation("TimelineEventTags")

  @@unique([projectId, name])
  @@index([projectId, deletedAt])
}

model ExportJob {
  id        String    @id @default(cuid())
  projectId String
  kind      String
  status    String
  s3Key     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MutationLog {
  id             String    @id @default(cuid())
  commandId      String    @unique
  transactionId  String?
  userId         String
  apiTokenId     String?
  projectId      String
  action         String
  targetType     String
  targetId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  rolledBackAt   DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@index([userId, projectId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model ReadingProgress {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  sceneId     String?
  scrollRatio Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId, updatedAt])
}
