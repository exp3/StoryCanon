{
  "name": "@storycanon/web",
  "private": true,
  "scripts": {
    "predev": "npm run db:node",
    "dev": "next dev",
    "build": "npm run db:node && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "prisma:generate": "npm run db:node",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "pretest": "npm run db:node",
    "prelint": "npm run db:node",
    "build:worker": "node scripts/build-worker.mjs",
    "deploy:worker": "node scripts/build-worker.mjs && wrangler deploy",
    "db:node": "prisma generate --generator client && npm --prefix ../../packages/db run build:node",
    "db:all": "prisma generate && npm --prefix ../../packages/db run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@storycanon/db": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.23.0",
    "posthog-js": "^1.410.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
