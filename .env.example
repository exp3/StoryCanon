DATABASE_URL="postgresql://storycanon:storycanon@localhost:5432/storycanon?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-local-secret"
GOOGLE_CLIENT_ID=""
