# checkout / billing portal sessions. Anything else keeps billing off.
PAYMENT_MODE="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PLUS_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
APP_API_TOKEN_PEPPER="replace-with-token-pepper"
EXPORT_BUCKET_NAME="storycanon-local-exports"
