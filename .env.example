DATABASE_URL="postgresql://storycanon:storycanon@localhost:5432/storycanon?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-local-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Billing kill switch: only the exact value "live" lets the app create Stripe
# checkout / billing portal sessions. Anything else keeps billing off.
PAYMENT_MODE="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PLUS_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
# GA4 measurement id. No NEXT_PUBLIC_ prefix on purpose — that would make Next.js
# inline it at build time, so the container env var would be ignored. Leave empty
# to disable analytics and the cookie consent banner entirely.
GA_MEASUREMENT_ID=""
APP_API_TOKEN_PEPPER="replace-with-token-pepper"
EXPORT_BUCKET_NAME="storycanon-local-exports"
# Local development only. Set to "1" to expose /dev-login, which signs you in as
# a local user without Google OAuth. Ignored entirely when NODE_ENV=production —
# never set this in a deployment.
DEV_LOGIN=""
